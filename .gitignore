# Binaries
bin/
*.exe
*.test
*.out

# But track compiled eBPF objects (needed for //go:embed on fresh clones)
!internal/collector/bpf_x86_bpfel.o
!internal/collector/bpf_arm64_bpfel.o

# Release binaries (attached to GitLab releases, not committed)
dist/

# Data
.rabbit-hole/
data/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coding Hermes
!.coding-hermes/tasks.md

# Hilo
.vfs/

# GitReins state (MCP-managed, never committed)
.gitreins/tasks.yaml
.gitreins/history/
.gitreins/*.bak

# eBPF vmlinux header (generated from kernel BTF, system-specific)
internal/collector/bpf/vmlinux.h

# eBPF compiled object files (bpf2go output, architecture-specific)
*.o

# Root binary (compiled output)
/rabbit-hole

# Environment & secrets
.env
.env.*
!.env.example

.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal
.coding-hermes/board/*.parquet
.coding-hermes/board/*.duckdb
